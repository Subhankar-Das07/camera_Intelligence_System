# App Redis connection (docker-compose sets this for the app service)
REDIS_URL=redis://redis:6379/0

# Local (non-Docker) development against a host Redis:
# REDIS_URL=redis://localhost:6379/0

# ── Docker Hub (team deploy from image) ──────────────────────────────────────
# Image: drpinfotech/camera-intelligence:develop
#   docker pull drpinfotech/camera-intelligence:develop
#   docker compose -f docker-compose.yml -f docker-compose.hub.yml up -d --no-build
# Open http://localhost:8000
